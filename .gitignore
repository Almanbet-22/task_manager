# Виртуальное окружение
.venv/
venv/
ENV/
env/

# Кэш Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Базы данных (SQLite, если локальная)
*.db
*.sqlite
*.sqlite3

# Переменные окружения и секреты (самое важное!)
